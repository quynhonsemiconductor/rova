{
  "compilerOptions": {
    "module": "commonjs",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@db/*": ["./db/*"],
      "@shared-kernel": ["./libs/shared-kernel/src/index"],
      "@shared-kernel/*": ["./libs/shared-kernel/src/*"],
      "@platform": ["./libs/platform/src/index"],
      "@platform/*": ["./libs/platform/src/*"],
      "@contracts": ["./libs/contracts/src/index"],
      "@contracts/*": ["./libs/contracts/src/*"],
      "@modules/identity": ["./libs/modules/identity/src/index"],
      "@modules/identity/*": ["./libs/modules/identity/src/*"],
      "@modules/workspace": ["./libs/modules/workspace/src/index"],
      "@modules/workspace/*": ["./libs/modules/workspace/src/*"],
      "@modules/access": ["./libs/modules/access/src/index"],
      "@modules/access/*": ["./libs/modules/access/src/*"],
      "@modules/projects": ["./libs/modules/projects/src/index"],
      "@modules/projects/*": ["./libs/modules/projects/src/*"],
      "@modules/work-items": ["./libs/modules/work-items/src/index"],
      "@modules/work-items/*": ["./libs/modules/work-items/src/*"],
      "@modules/activity": ["./libs/modules/activity/src/index"],
      "@modules/activity/*": ["./libs/modules/activity/src/*"],
      "@modules/attachments": ["./libs/modules/attachments/src/index"],
      "@modules/attachments/*": ["./libs/modules/attachments/src/*"],
      "@modules/workflow": ["./libs/modules/workflow/src/index"],
      "@modules/workflow/*": ["./libs/modules/workflow/src/*"],
      "@modules/iterations": ["./libs/modules/iterations/src/index"],
      "@modules/iterations/*": ["./libs/modules/iterations/src/*"],
      "@modules/releases": ["./libs/modules/releases/src/index"],
      "@modules/releases/*": ["./libs/modules/releases/src/*"],
      "@modules/collaboration": ["./libs/modules/collaboration/src/index"],
      "@modules/collaboration/*": ["./libs/modules/collaboration/src/*"],
      "@modules/notifications": ["./libs/modules/notifications/src/index"],
      "@modules/notifications/*": ["./libs/modules/notifications/src/*"],
      "@modules/audit": ["./libs/modules/audit/src/index"],
      "@modules/audit/*": ["./libs/modules/audit/src/*"],
      "@modules/reporting": ["./libs/modules/reporting/src/index"],
      "@modules/reporting/*": ["./libs/modules/reporting/src/*"],
      "@modules/team-status": ["./libs/modules/team-status/src/index"],
      "@modules/team-status/*": ["./libs/modules/team-status/src/*"],
      "@modules/milestones": ["./libs/modules/milestones/src/index"],
      "@modules/milestones/*": ["./libs/modules/milestones/src/*"],
      "@modules/capacity": ["./libs/modules/capacity/src/index"],
      "@modules/capacity/*": ["./libs/modules/capacity/src/*"],
      "@modules/portfolio": ["./libs/modules/portfolio/src/index"],
      "@modules/portfolio/*": ["./libs/modules/portfolio/src/*"],
      "@modules/quality": ["./libs/modules/quality/src/index"],
      "@modules/quality/*": ["./libs/modules/quality/src/*"],
      "@modules/scm": ["./libs/modules/scm/src/index"],
      "@modules/scm/*": ["./libs/modules/scm/src/*"],
      "@modules/api-tokens": ["./libs/modules/api-tokens/src/index"],
      "@modules/api-tokens/*": ["./libs/modules/api-tokens/src/*"],
      "@modules/test-cases": ["./libs/modules/test-cases/src/index"],
      "@modules/test-cases/*": ["./libs/modules/test-cases/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "apps/web"]
}
