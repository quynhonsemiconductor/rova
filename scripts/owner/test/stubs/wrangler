#!/usr/bin/env python3
# Stub of the wrangler calls the owner script makes. Pages secret NAMES live in $STUB_PAGES (JSON). Values are never kept.
import json, os, sys

args = sys.argv[1:]
P = os.environ["STUB_PAGES"]
pages = json.load(open(P)) if os.path.exists(P) else []
mode = os.environ.get("MOCK_WHOAMI", "in")

if args[:1] == ["whoami"]:
    if mode == "in":
        print("You are logged in with an OAuth Token, associated with the email owner@example.invalid.")
        sys.exit(0)
    if mode == "out-zero":   # the failure mode to catch: a non-zero-free exit with the unauthenticated text
        print("You are not authenticated. Please run `wrangler login`.")
        sys.exit(0)
    print("You are not authenticated. Please run `wrangler login`.")
    sys.exit(1)

if args[:2] == ["pages", "secret"] and args[2:3] == ["list"]:
    if os.environ.get("MOCK_PAGES_LIST_FAIL"):
        print("Error: authentication failed (stub)", file=sys.stderr)
        sys.exit(1)
    for name in pages:
        print(name)
    sys.exit(0)

if args[:2] == ["pages", "secret"] and args[2:3] == ["put"]:
    sys.stdin.read()          # the value is read and dropped
    if args[3] not in pages:
        pages.append(args[3])
    json.dump(pages, open(P, "w"))
    print("Success! (stub)")
    sys.exit(0)

print("stub wrangler: unmodelled call: " + " ".join(args), file=sys.stderr)
sys.exit(1)
