{
  "name": "rova",
  "version": "0.7.18",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "build:migrator": "tsc --project tsconfig.migrator.json",
    "build": "pnpm build:api && pnpm build:worker",
    "build:web": "pnpm --filter rova-web build",
    "dev:web": "pnpm --filter rova-web dev",
    "format": "prettier --write \"apps/api/**/*.ts\" \"apps/worker/**/*.ts\" \"libs/**/*.ts\" \"db/**/*.ts\"",
    "start:dev": "nest start api --watch",
    "start:dev:worker": "BETTER_AUTH_SECRET= IDENTITY_TEST_LOGIN= nest start worker --watch",
    "start:debug": "nest start api --debug --watch",
    "start:prod": "node dist/apps/api/apps/api/src/main.js",
    "start:prod:worker": "node dist/apps/worker/apps/worker/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{apps/api,apps/worker,libs,db}/**/*.ts\"",
    "lint:fix": "eslint \"{apps/api,apps/worker,libs,db}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "check:coverage-floors": "tsx test/check-coverage-floors.ts",
    "test:e2e": "vitest run --config test/vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:roles:enable": "tsx db/enable-least-privilege-roles.ts",
    "db:seed": "tsx db/seeds/seed.ts",
    "db:seed:test": "tsx db/seeds/seed.ts --fixtures",
    "db:backfill:accepted-date": "tsx db/backfill-accepted-date.ts",
    "db:identity-v8:backfill": "tsx db/identity-v8/cli.ts backfill",
    "db:identity-v8:rollback": "tsx db/identity-v8/cli.ts rollback",
    "db:identity-v8:mirror-bans": "tsx db/identity-v8/cli.ts mirror-bans",
    "db:report:custom-roles": "tsx db/report-custom-roles.ts",
    "db:studio": "drizzle-kit studio",
    "local:check": "tsx scripts/local/check.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/client-secrets-manager": "^3.1079.0",
    "@aws-sdk/client-sesv2": "^3.1114.0",
    "@aws-sdk/client-sqs": "^3.1114.0",
    "@aws-sdk/rds-signer": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@azure/identity": "^4.13.1",
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-fastify": "^11.2.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@quynhonsemiconductor/identity": "^8.5.0",
    "@quynhonsemiconductor/observability": "^0.6.2",
    "@quynhonsemiconductor/platform-cache": "^3.3.1",
    "@quynhonsemiconductor/platform-http": "^5.0.0",
    "@quynhonsemiconductor/platform-mail": "^0.1.5",
    "@quynhonsemiconductor/platform-runtime": "^0.3.1",
    "cockatiel": "^4.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.3",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.1",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.11.13",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "nodemailer": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.4",
    "semver": "7.8.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
